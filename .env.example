# SporeSec DarkWeb Scanner - Environment Configuration
# Copy this file to .env and fill in the values

# API Security
ADMIN_API_KEY=your-sturdy-admin-key-here
JWT_SECRET=your-secure-jwt-secret-here
SPORE_SIGNATURE=your-shared-signature-with-frontend

# Database
# If empty, the system will use a local SQLite file (data/sporesec.db)
DATABASE_URL=

# Networking
FRONTEND_DOMAIN=http://localhost:3000
RUST_LOG=info
